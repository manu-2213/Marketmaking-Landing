# ── Google Sheets integration ──
# Use the original spreadsheet in your Google account, shared with the service
# account. The first worksheet is used, as before. Existing rows are preserved;
# new entries are tagged with event_id = qmml-2026-november.

[sheets]
spreadsheet_id = "your-original-google-sheet-id"

[gcp_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = ""
client_email = ""
client_id = ""
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = ""
