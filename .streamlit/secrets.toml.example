# ── Google Sheets integration ──
# Create a dedicated, empty spreadsheet for 2026 registrations. Do not point
# this setting at a spreadsheet used by an earlier event. Share it with the
# Google Cloud service account below. The app creates a "Registrations" tab.

[sheets]
spreadsheet_id_2026 = "your-new-2026-google-sheet-id-here"

[gcp_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = ""
client_email = ""
client_id = ""
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = ""
